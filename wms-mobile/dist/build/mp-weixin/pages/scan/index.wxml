3"><text class="section-title data-v-70ccd2e3">最近扫码</text><text class="section-action data-v-70ccd2e3" bindtap="{{o}}">清空</text></view><view class="history-list data-v-70ccd2e3"><view wx:for="{{p}}" wx:for-item="item" wx:key="c" class="history-item data-v-70ccd2e3" bindtap="{{item.d}}"><text class="history-code data-v-70ccd2e3">{{item.a}}</text><text class="history-time data-v-70ccd2e3">{{item.b}}</text></view></view></view></view>