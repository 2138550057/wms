# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wms?schema=public"

# For development, you can use SQLite instead:
# DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="your-secret-key-change-in-production"

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Storage Configuration
# 存储类型: local, s3, qiniu, aliyun, tencent
STORAGE_TYPE=local

# 本地存储基础URL（可选，默认为http://localhost:PORT/uploads）
# STORAGE_BASE_URL=http://your-domain.com/uploads

# S3存储配置（可选）
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_ENDPOINT=https://s3.amazonaws.com  # 可选，用于MinIO等兼容S3的服务
# S3_FORCE_PATH_STYLE=false  # MinIO需要设置为true

# 七牛云存储配置（可选）
# QINIU_ACCESS_KEY=your-access-key
# QINIU_SECRET_KEY=your-secret-key
# QINIU_BUCKET=your-bucket-name
# QINIU_DOMAIN=your-cdn-domain.com
# QINIU_ZONE=Zone_z0  # 存储区域：Zone_z0(华东), Zone_z1(华北), Zone_z2(华南), Zone_na0(北美), Zone_as0(东南亚)

# 阿里云OSS配置（可选，待实现）
# ALIYUN_REGION=oss-cn-hangzhou
# ALIYUN_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_BUCKET=your-bucket-name

# 腾讯云COS配置（可选，待实现）
# TENCENT_SECRET_ID=your-secret-id
# TENCENT_SECRET_KEY=your-secret-key
# TENCENT_REGION=ap-guangzhou
# TENCENT_BUCKET=your-bucket-name

